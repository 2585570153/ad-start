---
// AD 智能助手 - 基于 Coze Chat SDK（前端公开配置）
const COZE_BOT_ID = '7678310070690086921';
const COZE_PAT = 'sat_aa0KxWJ5XRrrBjeiR50Zc6SW45ONmlNsADkDLsa9JPAssWMKD2NY0iIjuMjgmKhl';
const COZE_BOT_ICON = 'https://www.aiheadn.cn/favicon.ico';
---

<!-- Coze Chat SDK CDN（需 is:inline，否则 Astro 不会输出外部脚本） -->
<script is:inline src="https://lf-cdn.coze.cn/obj/unpkg/flow-platform/chat-app-sdk/1.2.0-beta.20/libs/cn/index.js"></script>

<!-- 自定义悬浮按钮（Coze 自带悬浮球已通过 ui.asstBtn.isNeed: false 关闭） -->
<div id="ad-chat-fab" class="fixed bottom-6 right-6 z-[9998] group cursor-pointer" role="button" aria-label="打开 AD 智能助手" tabindex="0">
  <div class="relative">
    <div class="absolute inset-0 bg-black rounded-full animate-ping opacity-20"></div>
    <div class="relative w-14 h-14 bg-black rounded-full flex items-center justify-center shadow-lg hover:shadow-2xl hover:scale-110 transition-all duration-300 ease-out border border-gray-200">
      <svg id="ad-chat-icon" class="w-7 h-7 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
      </svg>
      <svg id="ad-close-icon" class="w-7 h-7 text-white hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </div>
    <div class="absolute right-full mr-3 top-1/2 -translate-y-1/2 bg-black text-white text-sm px-3 py-1.5 rounded-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
      AD 智能助手
      <div class="absolute left-full top-1/2 -translate-y-1/2 border-4 border-transparent border-l-black"></div>
    </div>
  </div>
</div>

<!-- 用量上限提示 -->
<div id="ad-chat-limit-tip" class="fixed bottom-24 right-6 z-[9999] hidden max-w-xs bg-black text-white text-xs px-4 py-3 rounded-xl shadow-2xl border border-gray-700">
  <div class="flex items-start gap-2">
    <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <div>
      <p class="font-semibold mb-0.5">今日问答已达上限</p>
      <p class="text-gray-300">每天最多可发起 <span id="ad-chat-limit-num">30</span> 次对话，请明天再来～</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ botId: COZE_BOT_ID, pat: COZE_PAT, botIcon: COZE_BOT_ICON }}>
(function () {
  'use strict';

  // ============ 配置 ============
  var CONFIG = {
    BOT_ID: botId || '',
    TOKEN: pat || '',
    BOT_ICON: botIcon || '',
    DAILY_LIMIT: 30,        // 每用户每日对话轮数上限，0 = 不限
    MAX_MSG_LEN: 1000,      // 单条消息最大字符数
  };

  document.getElementById('ad-chat-limit-num').textContent = String(CONFIG.DAILY_LIMIT);

  // ============ 工具函数 ============
  function getUserId() {
    var id = localStorage.getItem('ad_chat_user_id');
    if (id) return id;
    var ua = navigator.userAgent;
    var hash = 0;
    for (var i = 0; i < ua.length; i++) {
      hash = ((hash << 5) - hash) + ua.charCodeAt(i);
      hash = hash & hash;
    }
    id = 'ad_user_' + Math.abs(hash).toString(36);
    localStorage.setItem('ad_chat_user_id', id);
    return id;
  }

  function todayKey() {
    var d = new Date();
    return 'ad_chat_cnt_' + d.getFullYear() + '_' + (d.getMonth() + 1) + '_' + d.getDate();
  }

  function getCount() {
    return parseInt(localStorage.getItem(todayKey()) || '0', 10) || 0;
  }

  function addCount() {
    localStorage.setItem(todayKey(), String(getCount() + 1));
  }

  function overLimit() {
    return CONFIG.DAILY_LIMIT > 0 && getCount() >= CONFIG.DAILY_LIMIT;
  }

  // ============ 初始化 SDK ============
  var sdkInited = false;
  var chatOpened = false;
  var chatClient = null;

  function initSDK() {
    if (sdkInited) return;
    if (typeof CozeWebSDK === 'undefined') {
      setTimeout(initSDK, 300);
      return;
    }
    if (!CONFIG.BOT_ID || !CONFIG.TOKEN) {
      console.warn('[AD智能助手] Coze 配置缺失，请检查 chat-widget.astro 中的 BOT_ID 和 TOKEN');
      return;
    }

    var uiBase = {
      lang: 'zh-CN',
      layout: 'pc',
      zIndex: 10000,
    };
    if (CONFIG.BOT_ICON) {
      uiBase.icon = CONFIG.BOT_ICON;
    }

    try {
      /* eslint-disable no-new, no-undef */
      chatClient = new CozeWebSDK.WebChatClient({
        config: {
          botId: CONFIG.BOT_ID,
        },
        auth: {
          type: 'token',
          token: CONFIG.TOKEN,
          onRefreshToken: function () {
            return CONFIG.TOKEN;
          },
        },
        userInfo: {
          id: getUserId(),
          nickname: '访客',
        },
        ui: {
          base: uiBase,
          asstBtn: {
            isNeed: false,
          },
          chatBot: {
            title: 'AD 智能助手',
            onShow: function () {
              chatOpened = true;
              updateFabIcon();
            },
            onHide: function () {
              chatOpened = false;
              updateFabIcon();
            },
          },
          footer: {
            isShow: false,
          },
        },
      });
      /* eslint-enable */
      sdkInited = true;
    } catch (e) {
      console.error('[AD智能助手] SDK 初始化失败:', e);
    }
  }

  // ============ 切换聊天窗口 ============
  function toggleChat() {
    if (overLimit()) {
      var tip = document.getElementById('ad-chat-limit-tip');
      tip.classList.remove('hidden');
      clearTimeout(window.__adTipTimer);
      window.__adTipTimer = setTimeout(function () {
        tip.classList.add('hidden');
      }, 4000);
      return;
    }

    if (!sdkInited) {
      initSDK();
      setTimeout(function () {
        if (chatClient) {
          chatClient.showChatBot();
          addCount();
        }
      }, 800);
      return;
    }

    if (!chatClient) return;

    if (chatOpened) {
      chatClient.hideChatBot();
    } else {
      chatClient.showChatBot();
      addCount();
    }
  }

  function updateFabIcon() {
    var chatIcon = document.getElementById('ad-chat-icon');
    var closeIcon = document.getElementById('ad-close-icon');
    if (chatOpened) {
      chatIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      chatIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  }

  // ============ 绑定事件 ============
  var fab = document.getElementById('ad-chat-fab');
  fab.addEventListener('click', toggleChat);
  fab.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      toggleChat();
    }
  });

  // 限制输入长度
  document.addEventListener('input', function (e) {
    var t = e.target;
    if (t && t.tagName === 'TEXTAREA' &&
        t.closest('[class*="coze"], [class*="chat-sdk"]')) {
      if (t.value.length > CONFIG.MAX_MSG_LEN) {
        t.value = t.value.slice(0, CONFIG.MAX_MSG_LEN);
      }
    }
  }, true);

  // 页面加载完成后初始化 SDK（预加载，首次点击秒开）
  if (document.readyState === 'complete') {
    initSDK();
  } else {
    window.addEventListener('load', initSDK);
  }
})();
</script>
